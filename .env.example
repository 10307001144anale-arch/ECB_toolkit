# ---------------------------------------------------------------------------
# CertiGen configuration. Copy this file to ".env" and fill in the values.
# ---------------------------------------------------------------------------

# Public URL of the app (no trailing slash). Used in QR verification links
# and for the Microsoft sign-in redirect.
APP_URL="http://localhost:3001"
PORT=3001

# Secret used to encrypt stored Microsoft / Google tokens. REQUIRED in production.
# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
APP_SECRET=""

# First administrator. Created on start-up only if no administrator exists.
# Remove ADMIN_PASSWORD after the first start. (Alternatively: npm run create-admin -- you@org "Name")
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# --- Supabase (required) --------------------------------------------------
# PostgreSQL "Session pooler" connection string (Project → Connect → Session pooler).
SUPABASE_DB_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Project URL and service_role key (Project Settings → API). Server only — never expose or commit.
SUPABASE_URL="https://PROJECTREF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Private Storage bucket for template files (created automatically).
SUPABASE_BUCKET="certificate-templates"

# Set to "true" when serving over HTTPS behind a proxy that does not set X-Forwarded-Proto.
COOKIE_SECURE="false"
# Set when running behind a reverse proxy (e.g. "true" or a hop count).
TRUST_PROXY=""

# --- Microsoft Excel (OneDrive / SharePoint) — optional --------------------
# See README "Microsoft Excel integration" for the Azure app registration steps.
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
# "common" (any work/school or personal account), "organizations", or your tenant ID.
MS_TENANT_ID="common"
# Defaults to $APP_URL/api/integrations/microsoft/callback
MS_REDIRECT_URI=""
# MS_SCOPES="offline_access User.Read Files.Read.All"

# --- Old data (only for `npm run migrate:supabase`) -------------------------
# DATA_DIR="./data"                 # folder of the old SQLite database
# DATABASE_URL="postgresql://…neon…" # only with --from-neon

# --- Google Sheets — optional ---------------------------------------------
# See README "Google Sheets integration" (enable Drive API + Sheets API, OAuth client of type Web).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to $APP_URL/api/integrations/google/callback
GOOGLE_REDIRECT_URI=""

# --- Optional AI box suggestions (Google Gemini) ---------------------------
# Only the blank template image is sent, after the administrator consents.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"

# --- Email for "Forgot password" verification codes -----------------------
# Free hosting that blocks email ports (Render free plan): use the Gmail relay —
# a Google Apps Script (scripts/gmail-relay.gs) that sends from your own Gmail.
# GMAIL_RELAY_URL = its Web app URL (ends in /exec); GMAIL_RELAY_SECRET = a long
# random value, the same as RELAY_SECRET in the script's Script Properties.
# Used first when both are set; delete them to use Brevo or Gmail/SMTP instead.
# GMAIL_RELAY_URL=""
# GMAIL_RELAY_SECRET=""
# Hosts that block email ports (Render free plan): set BREVO_API_KEY (brevo.com →
# SMTP & API → API Keys) and use a sender verified in Brevo as MAIL_FROM. When it is
# set, Brevo is used; delete it to go back to Gmail/SMTP below (e.g. on paid hosting).
# BREVO_API_KEY=""
# Gmail: turn on 2-Step Verification, then create an App password at
# https://myaccount.google.com/apppasswords (16 letters, no spaces).
# SMTP_USER and MAIL_FROM must be the same address. Without SMTP_HOST no
# verification codes can be sent.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# SMTP_SECURE="false"   # true for port 465
SMTP_USER="your.sender@gmail.com"
SMTP_PASSWORD=""
MAIL_FROM="ECB CertiGen <your.sender@gmail.com>"
