# ---------------------------------------------------------------------------
# CertiGen configuration. Copy this file to ".env" and fill in the values.
# ---------------------------------------------------------------------------

# Public URL of the app (no trailing slash). Used in QR verification links
# and for the Microsoft sign-in redirect.
APP_URL="http://localhost:3000"
PORT=3000

# Secret used to encrypt stored Microsoft / Google tokens. REQUIRED in production.
# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
APP_SECRET=""

# First administrator. Created on start-up only if no administrator exists.
# Remove ADMIN_PASSWORD after the first start. (Alternatively: npm run create-admin -- you@org "Name")
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Where the SQLite database and uploaded template files are stored.
DATA_DIR="./data"

# Set to "true" when serving over HTTPS behind a proxy that does not set X-Forwarded-Proto.
COOKIE_SECURE="false"
# Set when running behind a reverse proxy (e.g. "true" or a hop count).
TRUST_PROXY=""

# --- Microsoft Excel (OneDrive / SharePoint) — optional --------------------
# See README "Microsoft Excel integration" for the Azure app registration steps.
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
# "common" (any work/school or personal account), "organizations", or your tenant ID.
MS_TENANT_ID="common"
# Defaults to $APP_URL/api/integrations/microsoft/callback
MS_REDIRECT_URI=""
# MS_SCOPES="offline_access User.Read Files.Read.All"

# --- Google Sheets — optional ---------------------------------------------
# See README "Google Sheets integration" (enable Drive API + Sheets API, OAuth client of type Web).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to $APP_URL/api/integrations/google/callback
GOOGLE_REDIRECT_URI=""

# --- Optional AI box suggestions (Google Gemini) ---------------------------
# Only the blank template image is sent, after the administrator consents.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
